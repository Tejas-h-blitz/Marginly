{
  "name": "marginly",
  "version": "1.0.0",
  "private": true,
  "description": "Marginly - TypeScript, Express, Prisma, PostgreSQL, React, Vite, Tailwind CSS, Recharts",
  "scripts": {
    "dev": "npm run dev --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:client && npm run prisma:generate --prefix server && npm run build:server",
    "start": "npm run start --prefix server",
    "start:test": "npm run start:test --prefix server",
    "test:e2e": "node test-e2e.mjs",
    "test:security": "node test-auth-security.mjs",
    "test:stress": "node test-stress-utc.mjs",
    "test:pricing": "node test-pricing-versions.mjs",
    "test:imports": "node test-import-safety.mjs",
    "test:revenue": "node test-revenue-history.mjs",
    "test:customers": "node test-customer-merge.mjs",
    "test:performance": "node test-performance-50k.mjs"
  }
}
