# PostgreSQL Connection String (local instance, Supabase, Neon, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_cost_tracker?schema=public"

# Backend Server Port
PORT=3001

# Frontend URL for CORS
CLIENT_URL="http://localhost:5173"

# Clerk Authentication Keys (From https://dashboard.clerk.com -> API Keys)
# Frontend Publishable Key (Starts with pk_test_ or pk_live_)
VITE_CLERK_PUBLISHABLE_KEY=""

# Backend Secret Key (Starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=""
